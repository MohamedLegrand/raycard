PORT=3000
APP_ENV=development

# Instance PostgreSQL locale (utilisateur/mot de passe par défaut de ton install),
# base "raycard" à créer dedans : CREATE DATABASE raycard;
DATABASE_URL=postgres://postgres:123@localhost:5432/raycard?sslmode=disable

# Doit être remplacé par un secret réel d'au moins 32 caractères (ex:
# openssl rand -base64 32) — cette valeur d'exemple est explicitement
# refusée au démarrage (voir config.validerJWTSecret), justement parce
# qu'elle est visible par quiconque a accès à ce repo.
JWT_SECRET=change-moi-en-production

# Envoi d'email (OTP, mot de passe oublié...) via Brevo
BREVO_API_KEY=
BREVO_EMAIL_EXPEDITEUR=no-reply@raycard.app

# Connexion Google (Client ID de type "Web", voir Google Cloud Console).
# Utilisé comme audience pour vérifier les ID tokens envoyés par l'app.
GOOGLE_CLIENT_ID=

# OCR des documents KYC (Tesseract, appelé en local via le binaire
# `tesseract` — installer le paquet système `tesseract-ocr` +
# `tesseract-ocr-fra` sur la machine qui exécute le serveur).
UPLOADS_DIR=./uploads
TESSERACT_LANG=fra

# Agrégateur de paiement HR-Skills Pay (recharge Mobile Money du wallet).
# hrsk_pk_test_/hrsk_sk_test_ = sandbox, hrsk_pk_live_/hrsk_sk_live_ =
# production — c'est le préfixe de la clé qui détermine l'environnement,
# jamais une URL différente. Ne jamais commiter de clé "live".
HRPAY_PUBLIC_KEY=
HRPAY_SECRET_KEY=
# Secret de signature des webhooks (distinct des clés ci-dessus, fourni
# séparément par HR-Skills Pay lors de la configuration du webhook).
HRPAY_WEBHOOK_SECRET=

# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées
# par des virgules. Vide = CORS désactivé (aucune origine autorisée) —
# l'app mobile n'en a jamais besoin. À renseigner seulement si un front web
# (ex: back-office) appelle l'API directement depuis un navigateur.
# Exemple : CORS_ALLOWED_ORIGINS=https://backoffice.raycard.io
CORS_ALLOWED_ORIGINS=

